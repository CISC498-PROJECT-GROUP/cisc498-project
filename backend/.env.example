# Every key here is declared in `EnvKey` + `app_env` + `getEnvStatus()` in
# src/services/common/svc-env.ts. Adding a var means editing BOTH in the same commit.
# Read env only through `app_env` — never `process.env.X` outside svc-env.ts.

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3010
# Loopback by default. This API spends the key below for anyone who can reach it — do not bind it
# to 0.0.0.0 on a shared network.
HOST=127.0.0.1

# ── Chat (Anthropic Messages API) ───────────────────────────────────────────
# The key lives here and never in the extension bundle. Without it the API still boots, /health
# reports configured:false, and POST /chat/turn answers 503.
ANTHROPIC_API_KEY=
# Optional. Exact model id, no date suffix.
CHAT_MODEL=claude-sonnet-5-5
# Optional. low | medium | high | xhigh | max. Low keeps interactive answers quick and cheap;
# medium if multi-lookup answers come back thin.
CHAT_EFFORT=low

# ── Study PDFs (lecture digests and study guides) ───────────────────────────
# Optional. The model that writes study material. Exact model id, no date suffix.
STUDY_MODEL=claude-opus-5-5
# Optional. The Chrome or Chromium that prints study PDFs. Leave empty to use an installed Chrome,
# Edge or Chromium from its usual place; the Docker image sets /usr/bin/chromium. Without one the
# API still runs and POST /study/render answers 503.
CHROME_PATH=
