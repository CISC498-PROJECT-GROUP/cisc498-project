# Every key here is declared in `EnvKey` + `app_env` + `getEnvStatus()` in
# src/services/common/svc-env.ts. Adding a var means editing BOTH in the same commit.
# Read env only through `app_env` — never `process.env.X` outside svc-env.ts.

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3010
# Loopback by default. This API spends the key below for anyone who can reach it — do not bind it
# to 0.0.0.0 on a shared network.
HOST=127.0.0.1

# ── Chat (Anthropic Messages API) ───────────────────────────────────────────
# The key lives here and never in the extension bundle. Without it the API still boots, /health
# reports configured:false, and POST /chat/turn answers 503.
ANTHROPIC_API_KEY=
# Optional. Exact model id, no date suffix.
CHAT_MODEL=claude-opus-5
# Optional. low | medium | high | xhigh | max. Medium keeps interactive answers quick.
CHAT_EFFORT=medium
