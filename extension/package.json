{
    "name": "canvas-assistant-extension",
    "private": true,
    "version": "0.0.1",
    "scripts": {
        "dev": "bun run scripts/build.ts --watch",
        "build": "bun run scripts/build.ts",
        "preview": "bun run scripts/build.ts && bun run scripts/preview.ts",
        "lint": "tsc --noEmit -p .",
        "format": "prettier --config .prettierrc --write \"**/*.{ts,tsx,json,css}\"",
        "test": "bun test ./tests"
    },
    "dependencies": {
        "@canvas-assistant/shared": "workspace:*",
        "preact": "^10.29.0"
    },
    "devDependencies": {
        "@types/bun": "^1.3.13",
        "@types/chrome": "^0.3.0",
        "prettier": "^3.8.3",
        "typescript": "^5.9.3"
    }
}
