{
    "manifest_version": 3,
    "name": "Canvas Assistant",
    "version": "0.1.0",
    "description": "Ask about your Canvas courses — due dates, grades and syllabus details — right from the dashboard.",
    "background": { "service_worker": "background.js" },
    "content_scripts": [{ "matches": ["https://*.instructure.com/*", "https://canvas.udel.edu/*"], "js": ["content.js"], "run_at": "document_idle" }],
    "action": { "default_title": "Open your student dashboard" },
    "permissions": ["cookies", "declarativeNetRequestWithHostAccess"],
    "host_permissions": [
        "https://*.instructure.com/*",
        "https://stellic.udel.edu/*",
        "https://canvas.udel.edu/*",
        "https://*.inscloudgate.net/*",
        "https://*.instructure-uploads.com/*",
        "https://*.canvas-user-content.com/*",
        "https://*.kaltura.com/*"
    ]
}
